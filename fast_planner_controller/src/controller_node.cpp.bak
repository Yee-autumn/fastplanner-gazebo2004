#include <ros/ros.h>
#include <quadrotor_msgs/PositionCommand.h>
#include <mavros_msgs/PositionTarget.h>
#include <mavros_msgs/State.h>
#include <mavros_msgs/CommandBool.h>
#include <mavros_msgs/SetMode.h>

ros::Publisher setpoint_pub;
ros::ServiceClient arming_client;
ros::ServiceClient set_mode_client;
mavros_msgs::State current_state;
mavros_msgs::PositionTarget current_setpoint;
bool got_pos_cmd = false;

void state_cb(const mavros_msgs::State::ConstPtr& msg) {
    current_state = *msg;
}

void pos_cmd_cb(const quadrotor_msgs::PositionCommand::ConstPtr& msg) {
    current_setpoint.header.stamp = ros::Time::now();
    current_setpoint.coordinate_frame = mavros_msgs::PositionTarget::FRAME_LOCAL_NED;
    current_setpoint.type_mask =
        mavros_msgs::PositionTarget::IGNORE_VX |
        mavros_msgs::PositionTarget::IGNORE_VY |
        mavros_msgs::PositionTarget::IGNORE_VZ |
        mavros_msgs::PositionTarget::IGNORE_AFX |
        mavros_msgs::PositionTarget::IGNORE_AFY |
        mavros_msgs::PositionTarget::IGNORE_AFZ |
        mavros_msgs::PositionTarget::IGNORE_YAW_RATE;

    current_setpoint.position.x = msg->position.x;
    current_setpoint.position.y = -msg->position.y;
    current_setpoint.position.z = -msg->position.z;
    current_setpoint.yaw = -msg->yaw;

    got_pos_cmd = true;
    setpoint_pub.publish(current_setpoint);
}

int main(int argc, char** argv) {
    ros::init(argc, argv, "fast_planner_controller");
    ros::NodeHandle nh;

    setpoint_pub = nh.advertise<mavros_msgs::PositionTarget>("/mavros/setpoint_raw/local", 10);
    ros::Subscriber state_sub = nh.subscribe("/mavros/state", 10, state_cb);
    ros::Subscriber pos_cmd_sub = nh.subscribe("/planning/pos_cmd", 10, pos_cmd_cb);

    arming_client = nh.serviceClient<mavros_msgs::CommandBool>("/mavros/cmd/arming");
    set_mode_client = nh.serviceClient<mavros_msgs::SetMode>("/mavros/set_mode");

    ros::Rate rate(20.0);

    // 等 MAVROS 连接
    while (ros::ok() && !current_state.connected) {
        ros::spinOnce();
        rate.sleep();
    }
    ROS_INFO("MAVROS connected!");

    // 等收到第一条 pos_cmd
    while (ros::ok() && !got_pos_cmd) {
        ros::spinOnce();
        rate.sleep();
    }
    ROS_INFO("Got first pos_cmd!");

    // 持续发 setpoint，让 PX4 进入 Offboard 准备状态
    for (int i = 100; ros::ok() && i > 0; --i) {
        setpoint_pub.publish(current_setpoint);
        ros::spinOnce();
        rate.sleep();
    }

    // 切 Offboard
    mavros_msgs::SetMode offb_set_mode;
    offb_set_mode.request.custom_mode = "OFFBOARD";
    if (set_mode_client.call(offb_set_mode) && offb_set_mode.response.mode_sent) {
        ROS_INFO("Offboard enabled");
    }

    // 循环重试解锁 armed自动上锁，把while改成了for
    mavros_msgs::CommandBool arm_cmd;
    arm_cmd.request.value = true;
    for(int i=0;i<10 && ros::ok() ;++i) {
        if (arming_client.call(arm_cmd) && arm_cmd.response.success) {
            ROS_INFO("Vehicle armed");
            break;
        }
        ros::spinOnce();
        rate.sleep();
    }

    // 持续发 setpoint
    while (ros::ok()) {
    setpoint_pub.publish(current_setpoint);

    // 检查是否掉出 Offboard
    if (current_state.mode != "OFFBOARD") {
        mavros_msgs::SetMode offb_set_mode;
        offb_set_mode.request.custom_mode = "OFFBOARD";
        if (set_mode_client.call(offb_set_mode) && offb_set_mode.response.mode_sent) {
            ROS_INFO("Offboard re-enabled");
        }
    }

    // 检查是否自动上锁
    if (!current_state.armed) {
        mavros_msgs::CommandBool arm_cmd;
        arm_cmd.request.value = true;
        if (arming_client.call(arm_cmd) && arm_cmd.response.success) {
            ROS_INFO("Vehicle re-armed");
        }
    }

    ros::spinOnce();
    rate.sleep();
}

    return 0;
}
